#!/bin/bash
# fab-board — run board Makefile from project root
# Usage: fab-board <board> TOP=name [BUILD=path] [target]
#
# Example:
#   fab-board tangnano9k TOP=usb-keyboard BUILD=build/usb-keyboard

if [ $# -lt 2 ]; then
  echo "Usage: fab-board <board> TOP=name [BUILD=path] [target]"
  exit 1
fi

BOARD="$1"
shift

# Resolve BUILD to absolute path from current directory
ARGS=("BOARD=$BOARD")
for arg in "$@"; do
  case "$arg" in
    BUILD=*)
      BUILD_VAL="${arg#BUILD=}"
      if [[ "$BUILD_VAL" != /* ]]; then
        BUILD_VAL="$(pwd)/$BUILD_VAL"
      fi
      ARGS+=("BUILD=$BUILD_VAL")
      ;;
    *)
      ARGS+=("$arg")
      ;;
  esac
done

exec make -C "boards/$BOARD" "${ARGS[@]}"
